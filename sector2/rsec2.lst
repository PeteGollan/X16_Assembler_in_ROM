001248  2               ;-----------------------------------------------------
001248  2               ; FileExists
001248  2               ;
001248  2               ; Written by Tony3068 and posted on Discord:
001248  2               ; https://discord.com/channels/547559626024157184/629863245934755860/1359286644150108374
001248  2               ;
001248  2               ;   On Entry:   A   = length of name
001248  2               ;               X,Y = pointer to filename string
001248  2               ;   On Exit:  C = 0 - File exists
001248  2               ;                 1 - File does NOT exist
001248  2               ;             All other regs are preserved
001248  2               ;
001248  2               ; Note: The call setup is the same as SETNAM
001248  2               ;-----------------------------------------------------
001248  2               FileExists:
001248  2               
001248  2  48                   pha
001249  2  DA                   phx
00124A  2  5A                   phy
00124B  2               
00124B  2               ; Open and then immediately close the file:
00124B  2  20 BD FF             jsr SETNAM
00124E  2  A9 05                lda #FILE_EXISTS_LFN        ; LFN
001250  2  A2 08                ldx #8                      ; Device
001252  2  A8                   tay                         ; Use LFN as secondary
001253  2  20 BA FF             jsr SETLFS
001256  2  20 C0 FF             jsr OPEN
001259  2  A9 05                lda #FILE_EXISTS_LFN       ; LFN
00125B  2  20 C3 FF             jsr CLOSE
00125E  2               
00125E  2               ; Open the error channel and check the result:
00125E  2  A9 00                lda #0
001260  2  A2 A9                ldx #<Dummy_name
001262  2  A0 12                ldy #>Dummy_name
001264  2  20 BD FF             jsr SETNAM
001267  2  A9 0F                lda #15
001269  2  A2 08                ldx #8
00126B  2  A0 0F                ldy #15
00126D  2  20 BA FF             jsr SETLFS       ; All regs preserved
001270  2  20 C0 FF             jsr OPEN
001273  2               
001273  2  A2 0F                ldx #15
001275  2  20 C6 FF             jsr CHKIN        ; Destroys all regs, but it is OK
001278  2  20 E4 FF             jsr GETIN
00127B  2  C9 30                cmp #'0'
00127D  2  D0 07                bne _NotFound
00127F  2  20 E4 FF             jsr GETIN
001282  2  C9 30                cmp #'0'
001284  2  F0 0B                beq _Found
001286  2               
001286  2               _NotFound:
001286  2  20 9C 12             jsr _flushchars
001289  2  20 CC FF             jsr CLRCHN
00128C  2  7A                   ply
00128D  2  FA                   plx
00128E  2  68                   pla
00128F  2  38                   sec
001290  2  60                   rts
001291  2               
001291  2               _Found:
001291  2  20 9C 12             jsr _flushchars
001294  2  20 CC FF             jsr CLRCHN
001297  2  7A                   ply
001298  2  FA                   plx
001299  2  68                   pla
00129A  2  18                   clc
00129B  2  60                   rts
00129C  2               
00129C  2               ; Clear the rest of the error message:
00129C  2               _flushchars:
00129C  2  20 E4 FF             jsr GETIN
00129F  2  C9 0D                cmp #13
0012A1  2  D0 F9                bne _flushchars
0012A3  2  A9 0F                lda #15
0012A5  2  20 C3 FF             jsr CLOSE
0012A8  2  60                   rts
