000000r 1               ;---------------------------------------------------------------------------------------------
000000r 1               ; wsec.asm - Write Sector Utility
000000r 1               ;
000000r 1               ; Pete Wyspianski (AKA Gollan)
000000r 1               ; October 2026
000000r 1               ; Ottawa, Canada
000000r 1               ;
000000r 1               ; Sector format:
000000r 1               ;   512 bytes (256 words)
000000r 1               ;   Filled with the sector number ($0000-$FFFF)
000000r 1               ;   Checksum at $0002 and $0003 is the value that makes the entire sector sum to $FFFF
000000r 1               ;---------------------------------------------------------------------------------------------
000000r 1               VERS_MAJOR = 0
000000r 1               VERS_MINOR = 1
000000r 1               
000000r 1                       .include "sec.inc"
000000r 2               ;
000000r 2               ;---------------------------------------------------------------------------------------------
000000r 2               ; sec.inc - Common definitions for the write and read sector programs.
000000r 2               ;
000000r 2               ; Pete Wyspianski (AKA Gollan)
000000r 2               ; October 2026
000000r 2               ; Ottawa, Canada
000000r 2               ;---------------------------------------------------------------------------------------------
000000r 2               
000000r 2               DEBUG = 1
000000r 2               
000000r 2               .ifdef DEBUG
000000r 2               ; Aux JUMP Table
000000r 2               AuxCharOut    = $4006
000000r 2               AuxStrOut     = $4009
000000r 2               AuxBStrOut    = $400c
000000r 2               AuxRegsOut    = $400f
000000r 2               AuxMemOut     = $4012
000000r 2               AuxTrace      = $4015
000000r 2               AuxTraceA     = $4018
000000r 2               AuxByteOut    = $401B
000000r 2               AuxWordOut    = $401E
000000r 2               AuxRDTIMOut   = $4021
000000r 2               .endif
000000r 2               
000000r 2               FILE_EXISTS_LFN = 5     ; LFN for the FileExists function (must be unique)
000000r 2               SECTOR_FILE_LFN = 6     ; LFN for the sector file (read)
000000r 2               LOG_FILE_LFN    = 7     ; LFN for the log file (write)
000000r 2               
000000r 2               ;---------------------------------------------------------
000000r 2               ; Data structures and types
000000r 2               ;---------------------------------------------------------
000000r 2               ; Max file name/path will be 80 characters.
000000r 2               KBD_BUF_SIZE=80         ; Keyboard input (can't be smaller than STR_BUF_SIZE)
000000r 2               STR_BUF_SIZE=80         ; Number conversions and filenames
000000r 2               
000000r 2               SECTOR_SIZE = 512
000000r 2               
000000r 2               DEFAULT_NSECTORS = 500
000000r 2               
000000r 2               ;---------------------------------------------------------
000000r 2               ; KERNAL
000000r 2               ;---------------------------------------------------------
000000r 2               CHRIN   = $FFCF ; In: a=char, Out: y-reg preserved
000000r 2               CHROUT  = $FFD2 ; In: n/a  Out: a=char, xy-regs preserved
000000r 2               SETLFS  = $FFBA ; In: a=LFN, x=device (8), y=secondary (LFN) Out: all regs preserved
000000r 2               SETNAM  = $FFBD
000000r 2               LOAD    = $FFD5
000000r 2               GETIN   = $FFE4 ; In: n/a Out: a=char (or null), Out: xy-regs destroyed
000000r 2               OPEN    = $FFC0
000000r 2               CLOSE   = $FFC3
000000r 2               CLRCHN  = $FFCC ; In: n/a Out: ax-regs destroyed
000000r 2               READST  = $FFB7 ; In: n/a Out: a=status byte x-reg destroyed
000000r 2               CHKIN   = $FFC6 ; Set channel for char input
000000r 2               CHKOUT  = $FFC9 ; In: x=LFN Out: ax-regs destroyed
000000r 2               PLOT    = $FFF0 ; Set/Get cursor XY coordinates
000000r 2               EXTAPI  = $FEAB
000000r 2               MACPTR  = $FF44 ; In: a=bytes to read (0 for up to 512), xy=ptr to buffer, C=0 inc dest, C=1 don't inc dest Out: C=0 supported, xy=bytes read C=1 not supported
000000r 2               
000000r 2               sdcard_read_sector=$E5E4 ; bank 3 In: sector_LBA=lba (4 bytes) Out: C=1 success, C=0 error (NOTE it is reversed)
000000r 2               
000000r 2               ; EXTAPI sub-functions:
000000r 2               blink_enable = $14      ; x=0 blink, x!=0 no-blink
000000r 2               
000000r 2               READST_EOF = $40    ; EOF bit
000000r 2               
000000r 2               ; ZP Bank Registers:
000000r 2               RAM_BANK_REG = $00
000000r 2               ROM_BANK_REG = $01
000000r 2               
000000r 2               ; UNPUBLISHED KERNAL ADDRESSES (valid for R49):
000000r 2               SDCARD_CHECK_ALIVE_ADDR = $E72E     ; Bank 3
000000r 2               CLEAR_BUFFER_ADDR       = $C5C1     ; Bank 3
000000r 2               
000000r 1               
000000r 1               ;---------------------------------------------------------
000000r 1               ; Zero Page - $0022-$007F are available
000000r 1               ; The linker automatically starts this segment at $22
000000r 1               ;---------------------------------------------------------
000000r 1                   .zeropage
000000r 1                   .org $0022  ; Makes the *.lst file easier to read
000022  1  xx xx        AuxsZP:          .res 2    ; The auxs serial driver uses $22, so reserve it
000024  1  xx xx        MemPtr:          .res 2    ; 2 bytes
000026  1  xx xx        MemPtr1:         .res 2    ; 2 bytes
000028  1  xx xx        MemPtr2:         .res 2    ; 2 bytes - used by higher-level  functions
00002A  1  xx xx        SecPtrLow:       .res 2    ; Points to sector_buf ($000..$0FF)
00002C  1  xx xx        SecPtrHigh:      .res 2    ; Points to sector_buf ($100..$1FF)
00002E  1  xx xx        scratch0:        .res 2
000030  1  xx xx        scratch1:        .res 2
000032  1  xx xx        nSectors:        .res 2    ; Number of sectors
000034  1  xx xx        CurSector:       .res 2    ; Current sector
000036  1  xx xx        SectorCS:        .res 2    ; Sector checksum
000038  1  xx xx        buf_ptr:           .res 2   ; Buffer used by GetLineInput
00003A  1               
00003A  1               ;--------------------------------------------------
00003A  1               ; ca65:
00003A  1                       .segment "CODE"
00003A  1                       .org $0801
000801  1               
000801  1               ;--------------------------------------------------
000801  1               ; X16-ASM:
000801  1               ;        .list "sectorw.lst"
000801  1               ;        .direct
000801  1               ;        * = $801
000801  1               
000801  1               ; BASIC stub that SYSes to $08d
000801  1  0B 08 13 02      .byte $0b, $08, $13, $02, $9e, $32, $30, $36, $31, $00, $00, $00
000805  1  9E 32 30 36  
000809  1  31 00 00 00  
00080D  1               
00080D  1               ;---------------------------------------------
00080D  1               ; MAIN
00080D  1               ;---------------------------------------------
00080D  1               main:
00080D  1  D8                   cld                 ; Just in case
00080E  1               
00080E  1  A9 1D                lda #<HelloWriteStr
000810  1  A2 0D                ldx #>HelloWriteStr
000812  1  20 5C 0B             jsr StrOut
000815  1               
000815  1  A9 DC                lda #<Input_help_msg
000817  1  A2 0D                ldx #>Input_help_msg
000819  1  20 5C 0B             jsr StrOut
00081C  1               
00081C  1  20 B8 09             jsr GetWriteParams
00081F  1  B0 4B                bcs @exit               ; ESC pressed, so exit.
000821  1               
000821  1  20 51 09             jsr ReviewWriteParams
000824  1  B0 46                bcs @exit               ; ESC pressed or "no" selected, so exit.
000826  1               
000826  1  20 C1 08             jsr OpenFileWrite
000829  1  B0 41                bcs @exit               ; Taken if file open failed, or overwrite denied
00082B  1               
00082B  1               @write_sectors:
00082B  1               
00082B  1  64 34                stz CurSector
00082D  1  64 35                stz CurSector+1
00082F  1               
00082F  1  A9 79                lda #<writing_msg
000831  1  A2 0F                ldx #>writing_msg
000833  1  20 5C 0B             jsr StrOut
000836  1               
000836  1               @next_sector:
000836  1               
000836  1               ; See if the user wants to exit:
000836  1  20 E4 FF             jsr GETIN             ; Trashes y-reg
000839  1  C9 00                cmp #0
00083B  1  F0 08                beq @cont             ; Taken if no key
00083D  1  C9 1B                cmp #ESC              ; User entered ESC?
00083F  1  F0 33                beq @exit_halt        ; Taken if so...
000841  1  C9 03                cmp #BREAK            ; User entered ctrl-C?
000843  1  F0 2F                beq @exit_halt        ; Taken if so...
000845  1               
000845  1               @cont:
000845  1  20 55 0A             jsr CreateSector        ; Make a sector using CurSector
000848  1               
000848  1  20 7D 08             jsr WriteSector
00084B  1  B0 17                bcs @exit_close         ; Taken if something went wrong
00084D  1               
00084D  1  A9 2E                lda #'.'
00084F  1  20 D2 FF             jsr CHROUT
000852  1               
000852  1  E6 34                inc CurSector
000854  1  D0 02                bne @check_done
000856  1  E6 35                inc CurSector+1
000858  1               @check_done:
000858  1  A5 34                lda CurSector           ; Done when next CurSector equals nSectors
00085A  1  C5 32                cmp nSectors
00085C  1  D0 D8                bne @next_sector
00085E  1  A5 35                lda CurSector+1
000860  1  C5 33                cmp nSectors+1
000862  1  D0 D2                bne @next_sector
000864  1               
000864  1               @exit_close:
000864  1  A9 0D                lda #CR
000866  1  20 D2 FF             jsr CHROUT
000869  1  20 BB 08             jsr CloseFileWrite
00086C  1               
00086C  1               @exit:
00086C  1  A9 04                lda #<ByeStr
00086E  1  A2 0E                ldx #>ByeStr
000870  1  20 5C 0B             jsr StrOut
000873  1  60                   rts
000874  1               
000874  1               ; ESC or ctrl-c pressed during write:
000874  1               @exit_halt:
000874  1  A9 D1                lda #<Halt_msg
000876  1  A2 0F                ldx #>Halt_msg
000878  1  20 5C 0B             jsr StrOut
00087B  1  80 E7                bra @exit_close
00087D  1               
00087D  1               ;-----------------------------------------------------------
00087D  1               ; WriteSector
00087D  1               ;       Write prepared write_sector_buf to the open file.
00087D  1               ;
00087D  1               ; On Entry: SECTOR_FILE_LFN is open for writing
00087D  1               ;           sector_buf contains the sector to write
00087D  1               ;
00087D  1               ; On Exit:  C=0 - Sector was written successfully
00087D  1               ;           C=1 - Sector write failed
00087D  1               ;           A-reg has READST code if fail
00087D  1               ;
00087D  1               ; Uses: write_sector_buf
00087D  1               ;
00087D  1               ; Note: this code assumes that SECTOR_SIZE is 512
00087D  1               ;-----------------------------------------------------------
00087D  1               WriteSector:
00087D  1               
00087D  1  A2 06                ldx #SECTOR_FILE_LFN
00087F  1  20 C9 FF             jsr CHKOUT
000882  1  20 B7 FF             jsr READST              ; READST
000885  1  C9 00                cmp #0                  ; Error?
000887  1  D0 2B                bne @exit_err           ; Taken if error (A-reg has READST return)
000889  1               
000889  1               ; Write the sector to the file in two chunks:
000889  1               
000889  1  A0 00               ldy #0                  ; Index
00088B  1               @next0:
00088B  1  B9 8E 12             lda write_sector_buf,y        ; Write a byte from low half of the sector buffer
00088E  1  20 D2 FF             jsr CHROUT              ; y reg preserved
000891  1  20 B7 FF             jsr READST              ; READST
000894  1  C9 00                cmp #0                  ; Error?
000896  1  D0 1C                bne @exit_err           ; Taken if error (A-reg has READST return)
000898  1  C8                   iny
000899  1  D0 F0                bne @next0
00089B  1               
00089B  1  A0 00               ldy #0                  ; Index
00089D  1               @next1:
00089D  1  B9 8E 13             lda write_sector_buf+$100,y   ; Write a byte from high half of the sector buffer
0008A0  1  20 D2 FF             jsr CHROUT              ; y reg preserved
0008A3  1  20 B7 FF             jsr READST              ; READST
0008A6  1  C9 00                cmp #0                  ; Error?
0008A8  1  D0 0A                bne @exit_err           ; Taken if error (A-reg has READST return)
0008AA  1  C8                   iny
0008AB  1  D0 F0                bne @next1
0008AD  1               
0008AD  1                 ; Success exit:
0008AD  1               @exit_OK:
0008AD  1  48                   pha
0008AE  1  20 CC FF             jsr CLRCHN
0008B1  1  68                   pla
0008B2  1  18                   clc
0008B3  1  60                   rts
0008B4  1               
0008B4  1               ; CHKOUT or CHROUT error, a-reg has READST code:
0008B4  1               @exit_err:
0008B4  1  48                   pha
0008B5  1  20 CC FF             jsr CLRCHN
0008B8  1  68                   pla
0008B9  1  38                   sec
0008BA  1  60                   rts
0008BB  1               
0008BB  1               ;-------------------------------------------------------------
0008BB  1               ; CloseFileWrite - Close the file
0008BB  1               ;
0008BB  1               ; On Entry: n/a
0008BB  1               ; On Exit:  n/a
0008BB  1               ;
0008BB  1               ; Note: we could call READST to get the status, but we don't.
0008BB  1               ;-------------------------------------------------------------
0008BB  1               
0008BB  1               CloseFileWrite:
0008BB  1               
0008BB  1  A9 06                lda #SECTOR_FILE_LFN  ; Close the sector file
0008BD  1  20 C3 FF             jsr CLOSE
0008C0  1  60                   rts
0008C1  1               
0008C1  1               ;-----------------------------------------------------------
0008C1  1               ; OpenFileWrite - Open the file for writing
0008C1  1               ;
0008C1  1               ; On Entry: n/a
0008C1  1               ; On Exit:  C=0 - File is open for writing
0008C1  1               ;           C=1 - File open failed or overwrite was denied
0008C1  1               ;           A-reg has READST code if open fail
0008C1  1               ;           or 0 if overwrite was denied
0008C1  1               ;
0008C1  1               ;-----------------------------------------------------------
0008C1  1               OpenFileWrite:
0008C1  1               
0008C1  1               ; Set up for filename StrLen:
0008C1  1  A9 FE                lda #<kbd_buf      ; Get filename length
0008C3  1  A2 10                ldx #>kbd_buf
0008C5  1  20 73 0B             jsr StrLen         ; y-reg = length
0008C8  1               
0008C8  1               ; Set up for FileExists is a bit different:
0008C8  1  98                   tya                ; a-reg = fname length
0008C9  1  A2 FE                ldx #<kbd_buf
0008CB  1  A0 10                ldy #>kbd_buf
0008CD  1               
0008CD  1               ;   On Exit:  C = 0 - File exists
0008CD  1               ;                 1 - File does NOT exist
0008CD  1  20 B6 0C             jsr FileExists
0008D0  1  B0 2C                bcs @prep_fname    ; Taken if it does NOT exist (skip overwrite prompt)
0008D2  1               
0008D2  1               ; Data file exists, so see if overwrite is OK with the user:
0008D2  1               
0008D2  1  A9 21                lda #<overwrite_msgD    ; msgD for Data.
0008D4  1  A2 0F                ldx #>overwrite_msgD
0008D6  1  20 5C 0B             jsr StrOut
0008D9  1  A9 FE                lda #<kbd_buf
0008DB  1  A2 10                ldx #>kbd_buf
0008DD  1  20 5C 0B             jsr StrOut
0008E0  1  A9 38                lda #<overwrite_msg1
0008E2  1  A2 0F                ldx #>overwrite_msg1
0008E4  1  20 5C 0B             jsr StrOut
0008E7  1               
0008E7  1  20 88 0A             jsr GetYN
0008EA  1               
0008EA  1                       ; Give a little space...
0008EA  1  08                   php
0008EB  1  48                   pha
0008EC  1  A9 0D                lda #CR
0008EE  1  20 D2 FF             jsr CHROUT
0008F1  1  A9 0D                lda #CR
0008F3  1  20 D2 FF             jsr CHROUT
0008F6  1  68                   pla
0008F7  1  28                   plp
0008F8  1               
0008F8  1  B0 51                bcs @exit_esc      ; Taken if ESC pressed
0008FA  1  C9 4E                cmp #PETSCII_N     ; Rejected?
0008FC  1  F0 4D                beq @exit_esc      ; Taken if so
0008FE  1               
0008FE  1               ; Prepare the filename by adding the overwrite string at the beginning and the mode string at the end:
0008FE  1               @prep_fname:
0008FE  1  A9 4E                lda #<str_buf      ; Assemble the filename in str_buf
000900  1  A2 11                ldx #>str_buf
000902  1  85 24                sta MemPtr
000904  1  86 25                stx MemPtr+1
000906  1               
000906  1               ; Copy the "@:" (overwrite) prefix to the buffer:
000906  1               
000906  1  A2 00               ldx     #0       ; Index for strings being copied
000908  1  A0 00               ldy     #0       ; Index for string at (MemPtr) (str_buf)
00090A  1               @next0:
00090A  1  BD F1 10             lda     OverwriteStr,x
00090D  1  91 24                sta     (MemPtr),y
00090F  1  F0 04                beq     @cont0          ; Taken if we loaded/saved a zero
000911  1  E8                   inx
000912  1  C8                   iny
000913  1  D0 F5                bne     @next0          ; Taken if not
000915  1               @cont0:
000915  1               
000915  1               ; Copy the file name to the buffer after the prefix
000915  1               ; (y-reg points to the end of the string in the strbuf buffer)
000915  1               
000915  1  A2 00               ldx     #0
000917  1               @next1:
000917  1  BD FE 10             lda     kbd_buf,x
00091A  1  91 24                sta     (MemPtr),y
00091C  1  F0 04                beq     @cont1          ; Taken if we just loaded/saved a zero
00091E  1  E8                   inx
00091F  1  C8                   iny
000920  1  D0 F5                bne     @next1          ; Taken if not
000922  1               
000922  1                @cont1:
000922  1               
000922  1               ; Append the write mode string to the prefix and filename in the buffer
000922  1               ; (y-reg points to the end of the string in the strbuf buffer)
000922  1               
000922  1  A2 00                ldx     #0
000924  1               @next2:
000924  1  BD F4 10             lda     WriteModeStr,x
000927  1  91 24                sta     (MemPtr),y
000929  1  F0 04                beq      @cont2
00092B  1  E8                   inx
00092C  1  C8                   iny
00092D  1  D0 F5                bne     @next2           ; Taken if not
00092F  1               
00092F  1               @cont2:
00092F  1               
00092F  1               ; Set up for the SETNAM call:
00092F  1  98                   tya                                  ; y-reg = strlen
000930  1  A2 4E                ldx #<str_buf
000932  1  A0 11                ldy #>str_buf
000934  1               
000934  1  20 BD FF             jsr SETNAM           ; SETNAM (no return value or flag)
000937  1               
000937  1  A9 06                lda #SECTOR_FILE_LFN    ; Logical file number
000939  1  A2 08                ldx #8                  ; Device number (always 8)
00093B  1  A8                   tay                     ; Secondary is LFN
00093C  1               
00093C  1  20 BA FF             jsr SETLFS              ; SETLFS - A-logical file number, X-device (8), y secondary (no return value or flag)
00093F  1  20 C0 FF             jsr OPEN                ; OPEN (no params), C=1 on error
000942  1  20 B7 FF             jsr READST              ; READST
000945  1  C9 00                cmp #0                  ; Error?
000947  1  D0 06                bne @exit_err           ; Taken if error (A-reg has READST return)
000949  1               
000949  1               ; Success exit:
000949  1               @exit_OK:
000949  1  18                   clc
00094A  1  60                   rts
00094B  1               
00094B  1               ; For ESC or "no" entered:
00094B  1               @exit_esc:
00094B  1  A9 00                lda #0
00094D  1  38                   sec
00094E  1  60                   rts
00094F  1               
00094F  1               ; OPEN error, a-reg has READST code:
00094F  1               @exit_err:
00094F  1  38                   sec
000950  1  60                   rts
000951  1               
000951  1               ;-----------------------------------------------------------
000951  1               ; ReviewWriteParams - Confirm write parameters
000951  1               ;
000951  1               ; On Entry: n/a
000951  1               ; On Exit:  C=0 - write params confirmed
000951  1               ;           C=1 - ESC was entered, exit request
000951  1               ;-----------------------------------------------------------
000951  1               ReviewWriteParams:
000951  1  A9 C3                lda #<nSectors_review
000953  1  A2 0E                ldx #>nSectors_review
000955  1  20 5C 0B             jsr StrOut
000958  1               
000958  1               ; Set up to convert and display nSectors:
000958  1  A9 4E                lda #<str_buf
00095A  1  85 24                sta MemPtr
00095C  1  A9 11                lda #>str_buf
00095E  1  85 25                sta MemPtr+1
000960  1               
000960  1  A5 32                lda nSectors
000962  1  A6 33                ldx nSectors+1
000964  1  20 82 0B             jsr Hex16Dec    ; Convert to string
000967  1               
000967  1  A9 4E                lda #<str_buf   ; Show nSectors
000969  1  A2 11                ldx #>str_buf
00096B  1  20 5C 0B             jsr StrOut
00096E  1               
00096E  1  A9 0D                lda #CR
000970  1  20 D2 FF             jsr CHROUT
000973  1               
000973  1  A9 D0                lda #<FileName_review
000975  1  A2 0E                ldx #>FileName_review
000977  1  20 5C 0B             jsr StrOut
00097A  1               
00097A  1  A9 FE                lda #<kbd_buf   ; Show the filename
00097C  1  A2 10                ldx #>kbd_buf
00097E  1  20 5C 0B             jsr StrOut
000981  1  A9 0D                lda #CR
000983  1  20 D2 FF             jsr CHROUT
000986  1  A9 0D                lda #CR
000988  1  20 D2 FF             jsr CHROUT
00098B  1               
00098B  1  A9 BC                lda #<YN_prompt ; Confirm with user...
00098D  1  A2 0E                ldx #>YN_prompt
00098F  1  20 5C 0B             jsr StrOut
000992  1  20 88 0A             jsr GetYN
000995  1               
000995  1               ; Give a little space...
000995  1  08                   php
000996  1  48                   pha
000997  1  A9 0D                lda #CR
000999  1  20 D2 FF             jsr CHROUT
00099C  1  A9 0D                lda #CR
00099E  1  20 D2 FF             jsr CHROUT
0009A1  1  68                   pla
0009A2  1  28                   plp
0009A3  1               
0009A3  1  B0 11                bcs @exit_esc      ; Taken if ESC pressed
0009A5  1  C9 4E                cmp #PETSCII_N     ; Rejected?
0009A7  1  F0 0D                beq @exit_esc      ; Taken if so
0009A9  1               
0009A9  1               
0009A9  1  A9 0D                lda #CR
0009AB  1  20 D2 FF             jsr CHROUT
0009AE  1  A9 0D                lda #CR
0009B0  1  20 D2 FF             jsr CHROUT
0009B3  1  60                   rts
0009B4  1               
0009B4  1               @exit_OK:
0009B4  1  18                   clc
0009B5  1  60                   rts
0009B6  1               
0009B6  1               ; For ESC or "no" entered:
0009B6  1               @exit_esc:
0009B6  1  38                   sec
0009B7  1  60                   rts
0009B8  1               
0009B8  1               ;-----------------------------------------------------------
0009B8  1               ; GetWriteParams - Prompt for write parameters
0009B8  1               ;
0009B8  1               ; On Entry: n/a
0009B8  1               ; On Exit:  C=0 - write params are set
0009B8  1               ;           C=1 - ESC was entered, exit request
0009B8  1               ;-----------------------------------------------------------
0009B8  1               GetWriteParams:
0009B8  1  A9 25                lda #<HowMany_prompt
0009BA  1  A2 0E                ldx #>HowMany_prompt
0009BC  1  20 5C 0B             jsr StrOut
0009BF  1  A9 FE                lda #<kbd_buf
0009C1  1  A2 10                ldx #>kbd_buf
0009C3  1  20 D9 0A             jsr GetLineInput
0009C6  1  B0 5B                bcs @exit_esc        ; Taken if ESC pressed
0009C8  1               
0009C8  1  C0 00                cpy #0               ; RETURN entered?
0009CA  1  D0 0A                bne @convert         ; Taken if NOT
0009CC  1               
0009CC  1               ; Enter the default value for nSectors:
0009CC  1  A9 F4                lda #<DEFAULT_NSECTORS
0009CE  1  85 32                sta nSectors
0009D0  1  A9 01                lda #>DEFAULT_NSECTORS
0009D2  1  85 33                sta nSectors+1
0009D4  1  80 16                bra @get_fname
0009D6  1               
0009D6  1               @convert:
0009D6  1  A9 0D                lda #CR
0009D8  1  20 D2 FF             jsr CHROUT
0009DB  1               
0009DB  1  A9 FE                lda #<kbd_buf
0009DD  1  A2 10                ldx #>kbd_buf
0009DF  1  20 03 0C             jsr ConvDec16
0009E2  1  B0 D4                bcs GetWriteParams   ; Try again if error (number too big)
0009E4  1               
0009E4  1               ; Save entered value into nSectors:
0009E4  1  85 32                sta nSectors
0009E6  1  86 33                stx nSectors+1
0009E8  1  05 33                ora nSectors+1  ; cheeky check for zero..
0009EA  1  F0 CC                beq GetWriteParams   ; Try again if zero entered
0009EC  1               
0009EC  1               ; Get the filename:
0009EC  1               @get_fname:
0009EC  1  A9 0D                lda #CR
0009EE  1  20 D2 FF             jsr CHROUT
0009F1  1               
0009F1  1  A9 84                lda #<FileName_prompt
0009F3  1  A2 0E                ldx #>FileName_prompt
0009F5  1  20 5C 0B             jsr StrOut
0009F8  1  A9 FE                lda #<kbd_buf
0009FA  1  A2 10                ldx #>kbd_buf
0009FC  1  20 D9 0A             jsr GetLineInput
0009FF  1  B0 22                bcs @exit_esc        ; ESC pressed...
000A01  1               
000A01  1  C0 00                cpy #0               ; Just RETURN entered (default)?
000A03  1  D0 1C                bne @exit            ; Taken if NOT
000A05  1               
000A05  1               ; Enter the default value for fname:
000A05  1  A9 74                lda #<DEFAULT_FNAME
000A07  1  85 24                sta MemPtr
000A09  1  A9 0E                lda #>DEFAULT_FNAME
000A0B  1  85 25                sta MemPtr+1
000A0D  1               
000A0D  1  A0 00                ldy #0
000A0F  1               @fname_copy:
000A0F  1  B1 24                lda (MemPtr),y
000A11  1  F0 06                beq @cont
000A13  1  99 FE 10             sta kbd_buf,y
000A16  1  C8                   iny
000A17  1  80 F6                bra @fname_copy
000A19  1               
000A19  1               @cont:
000A19  1  99 FE 10             sta kbd_buf,y        ; Null-terminate the string (a-reg has null)
000A1C  1               
000A1C  1  A9 0D                lda #CR
000A1E  1  20 D2 FF             jsr CHROUT
000A21  1               
000A21  1               @exit:
000A21  1  18                   clc
000A22  1  60                   rts
000A23  1               
000A23  1               @exit_esc:
000A23  1  38                   sec
000A24  1  60                   rts
000A25  1               
000A25  1                   .include "sec_utils.asm"
000A25  2               ;---------------------------------------------------------------------------------------------
000A25  2               ; sec_utils.asm - Common utility functions for the write and read sector programs.
000A25  2               ;
000A25  2               ; Included in the main program source files.
000A25  2               ;
000A25  2               ; Pete Wyspianski (AKA Gollan)
000A25  2               ; October 2026
000A25  2               ; Ottawa, Canada
000A25  2               ;---------------------------------------------------------------------------------------------
000A25  2               ; Contents:
000A25  2               ;   CONTROL CODES
000A25  2               ;   CalcSectorChecksum - Calculates a simple checksum for a specified sector_buf
000A25  2               ;   CreateSector - Creates a sector in write_sector_buf using CurSector
000A25  2               ;   GetYN - Waits until Y, N, RETURN, or ESC is pressed
000A25  2               ;   GetCharInput - reads a single character of keyboard input
000A25  2               ;   GetLineInput - Reads a line of keyboard input
000A25  2               ;   TextToHex - Convert PETSCII hex digit in A-reg to a hex digit
000A25  2               ;   StrOut
000A25  2               ;   StrLen
000A25  2               ;   Hex16Dec - Converts a 16-bit word to ASCII decimal digits
000A25  2               ;   Div10 - Divides a 16-bit word by 10 returning the quotient and remainder.
000A25  2               ;   ConvDec16 - Converts a 1-5 digit decimal number to 16-bit hexidecimal (0-65535)
000A25  2               ;   FileExists - Checks if a file exists
000A25  2               ;   WordOut - prints a given word in hexadecimal
000A25  2               ;   Word32Out - prints the given 4-byte value in hexadecimal
000A25  2               ;   Hex3Out - prints the hex value of 3 digit value
000A25  2               ;   ByteOut - prints the hex value of a given byte
000A25  2               
000A25  2               
000A25  2               ;---------------------------------------------------------
000A25  2               ; Control Codes
000A25  2               ;---------------------------------------------------------
000A25  2               
000A25  2               BREAK = $03   ; Ctrl-C
000A25  2               BELL  = $07   ; More like a beep
000A25  2               LF    = $0A   ; AKA \n - New line in Linux AND X16-EDIT ISO mode
000A25  2               CR    = $0D   ; AKA \r - New line character in Commodore and CX16 PETSCII
000A25  2               BS    = $14   ; Backspace key and character
000A25  2               ESC   = $1B   ; ESC key
000A25  2               SPACE = $20   ; Space key and character
000A25  2               DQ    = $22   ; Double quote (stress-free way to include double quote in strings)
000A25  2               
000A25  2               
000A25  2               ISO_OFF = $8F   ; Also clears screen
000A25  2               PETSCII_U = $8E
000A25  2               PETSCII_UL = $0E
000A25  2               CLS = $93
000A25  2               
000A25  2               ; Some assemblers do dodgy things with text so..
000A25  2               PETSCII_A = $41           ; PETSCII "A"
000A25  2               PETSCII_B = $42           ; PETSCII "B"
000A25  2               PETSCII_C = $43           ; PETSCII "C"
000A25  2               PETSCII_M = $4D           ; PETSCII "M"
000A25  2               PETSCII_N = $4E           ; PETSCII "N"
000A25  2               PETSCII_S = $5E           ; PETSCII "S"
000A25  2               PETSCII_Y = $59           ; PETSCII "Y"
000A25  2               PETSCII_Z = $7A           ; PETSCII "Z"
000A25  2               
000A25  2               
000A25  2               ;------------------------------------------------------------------
000A25  2               ; CalcSectorCheckum
000A25  2               ;       Calculates a simple checksum for a specified sector_buf
000A25  2               ;
000A25  2               ; On Entry: a,x - pointer to a sector_buf to use
000A25  2               ; On Exit:  SectorCS contains the checksum
000A25  2               ;
000A25  2               ; Uses: (ZP) SectorCS, SecPtrLow, SecPtrHigh
000A25  2               ; Note: this code assumes that SECTOR_SIZE is 512
000A25  2               ;------------------------------------------------------------------
000A25  2               CalcSectorChecksum:
000A25  2               
000A25  2  85 2A                sta SecPtrLow              ; Save the sector_buf pointer
000A27  2  86 2B                stx SecPtrLow+1
000A29  2  85 2C                sta SecPtrHigh
000A2B  2  E8                   inx                        ; Add $100 to SecPtrHigh
000A2C  2  86 2D                stx SecPtrHigh+1
000A2E  2               
000A2E  2  64 36                stz SectorCS
000A30  2  64 37                stz SectorCS+1
000A32  2               
000A32  2  A0 00                ldy #0                  ; Index
000A34  2               @next:
000A34  2  18                   clc
000A35  2  B1 2A                lda (SecPtrLow),y        ; Add a word from low half of buffer to SectorCS
000A37  2  65 36                adc SectorCS
000A39  2  85 36                sta SectorCS
000A3B  2  C8                   iny
000A3C  2  B1 2A                lda (SecPtrLow),y
000A3E  2  65 37                adc SectorCS+1
000A40  2  85 37                sta SectorCS+1
000A42  2  88                   dey
000A43  2               
000A43  2  18                   clc
000A44  2  B1 2C                lda (SecPtrHigh),y   ; Add a word from high half of buffer to SectorCS
000A46  2  65 36                adc SectorCS
000A48  2  85 36                sta SectorCS
000A4A  2  C8                   iny
000A4B  2  B1 2C                lda (SecPtrHigh),y
000A4D  2  65 37                adc SectorCS+1
000A4F  2  85 37                sta SectorCS+1
000A51  2               
000A51  2  C8                   iny             ; y-reg has already been incremented once, so one more for next word
000A52  2  D0 E0                bne @next
000A54  2               
000A54  2  60                   rts
000A55  2               
000A55  2               ;-----------------------------------------------------------
000A55  2               ; CreateSector
000A55  2               ;       Create a sector in write_sector_buf using CurSector
000A55  2               ;
000A55  2               ; On Entry: n/a
000A55  2               ; On Exit:  n/a
000A55  2               ;
000A55  2               ; Uses: write_sector_buf
000A55  2               ;
000A55  2               ; Note: this code assumes that SECTOR_SIZE is 512
000A55  2               ;-----------------------------------------------------------
000A55  2               CreateSector:
000A55  2               
000A55  2               ; Populate the sector with its CurSector ID word:
000A55  2               
000A55  2  A2 00                ldx #0                  ; Index
000A57  2               @next:
000A57  2  A5 34                lda CurSector           ; LSB of sector ID
000A59  2  9D 8E 12             sta write_sector_buf,x        ; Low half of buffer
000A5C  2  9D 8E 13             sta write_sector_buf+$100,x   ; High half of buffer
000A5F  2  A5 35                lda CurSector+1         ; MSB of sector ID
000A61  2  9D 8F 12             sta write_sector_buf+1,x      ; Low half of buffer
000A64  2  9D 8F 13             sta write_sector_buf+$101,x   ; High half of buffer
000A67  2  E8                   inx
000A68  2  E8                   inx
000A69  2  D0 EC                bne @next
000A6B  2               
000A6B  2               ; Set bytes 2 and 3 to zero for checksum computation:
000A6B  2               
000A6B  2  9C 90 12             stz write_sector_buf+2
000A6E  2  9C 91 12             stz write_sector_buf+3
000A71  2               
000A71  2               ; Get the checksum for this buffer with the CS set to zero:
000A71  2               
000A71  2  A9 8E                lda #<write_sector_buf
000A73  2  A2 12                ldx #>write_sector_buf
000A75  2  20 25 0A             jsr CalcSectorChecksum
000A78  2               
000A78  2               ; Calculate the final checksum:
000A78  2               
000A78  2  A9 FF                lda #$ff
000A7A  2  38                   sec
000A7B  2  E5 36                sbc SectorCS
000A7D  2  8D 90 12             sta write_sector_buf+2
000A80  2  A9 FF                lda #$ff
000A82  2  E5 37                sbc SectorCS+1
000A84  2  8D 91 12             sta write_sector_buf+3
000A87  2  60                   rts
000A88  2               
000A88  2               
000A88  2               ;-----------------------------------------------------------
000A88  2               ; GetYN - Waits until Y, N, RETURN, or ESC is pressed
000A88  2               ;
000A88  2               ; On Entry: n/a
000A88  2               ; On Exit:  C=0 A character was pressed:
000A88  2               ;           a-reg = char pressed ("Y","N")
000A88  2               ;             If RETURN was pressed: returns "Y"
000A88  2               ;           C=1 ESC was pressed, no input
000A88  2               ;             ax-regs destroyed
000A88  2               ;
000A88  2               ; Uses: n/a
000A88  2               ;-----------------------------------------------------------
000A88  2               GetYN:
000A88  2  20 E4 FF             jsr GETIN   ; Trashes y-reg
000A8B  2  C9 00                cmp #0
000A8D  2  F0 F9                beq GetYN
000A8F  2  C9 1B                cmp #ESC             ; ESC pressed?
000A91  2  F0 14                beq @exit_esc
000A93  2  C9 0D                cmp #CR              ; ENTER pressed?
000A95  2  D0 04                bne @not_CR          ; Taken if NOT
000A97  2  A9 59                lda #PETSCII_Y       ; Default is 'Y'
000A99  2  80 0A                bra @exit
000A9B  2               
000A9B  2               @not_CR:
000A9B  2  29 5F                and #$5F             ; Shift UPPER characters to PETSCII
000A9D  2  C9 59                cmp #PETSCII_Y
000A9F  2  F0 04                beq @exit            ; Taken if so
000AA1  2  C9 4E                cmp #PETSCII_N
000AA3  2  D0 E3                bne GetYN            ; Taken if NOT
000AA5  2               
000AA5  2               @exit:
000AA5  2  18                   clc
000AA6  2  60                   rts
000AA7  2               
000AA7  2               @exit_esc:
000AA7  2  38                   sec
000AA8  2  60                   rts
000AA9  2               
000AA9  2               
000AA9  2               
000AA9  2               ;-----------------------------------------------------------
000AA9  2               ; GetCharInput - reads a single character of keyboard input
000AA9  2               ;                and returns SCREEN CODES (see Notes)
000AA9  2               ; On Entry: n/a
000AA9  2               ; On Exit:  C=0 - A character or RETURN was pressed
000AA9  2               ;             a- reg = char
000AA9  2               ;           C=1 ESC was pressed, no input
000AA9  2               ;
000AA9  2               ; NoteS: Restricted to printable characters
000AA9  2               ;        Returns SCREEN CODES, not PETSCII
000AA9  2               ;  ***** This should call a ScreenCodeToPETSCII function
000AA9  2               ;-----------------------------------------------------------
000AA9  2               GetCharInput:
000AA9  2               
000AA9  2  A9 14                lda #blink_enable   ; Turn ON the blinking cursor:
000AAB  2  A2 00                ldx #0              ; 0=blink enable
000AAD  2  20 AB FE             jsr EXTAPI
000AB0  2               
000AB0  2               @key_wait:
000AB0  2  20 E4 FF             jsr GETIN             ; Trashes y-reg
000AB3  2  C9 00                cmp #0
000AB5  2  F0 F9                beq @key_wait
000AB7  2               
000AB7  2  48                   pha                  ; A key was pressed, so turn OFF the blinking cursor
000AB8  2  A9 14                lda #blink_enable
000ABA  2  A2 FF                ldx #$FF             ; $FF=blink disable
000ABC  2  20 AB FE             jsr EXTAPI
000ABF  2  68                   pla
000AC0  2               
000AC0  2  C9 0D                cmp #CR              ; ENTER key?
000AC2  2  F0 11                beq @exit_ok         ; Taken if so
000AC4  2  C9 1B                cmp #ESC             ; ESC key?
000AC6  2  F0 0F                beq @exit_esc        ; Taken if so
000AC8  2  C9 20                cmp #' '             ; Printable?
000ACA  2  90 E4                bcc @key_wait        ; Taken if NOT (try again)
000ACC  2  C9 7B                cmp #PETSCII_Z+1
000ACE  2  B0 E0                bcs @key_wait        ; Taken if NOT printable (try again)
000AD0  2  AA                   tax                  ; Save the char
000AD1  2  20 D2 FF             jsr CHROUT           ; Echo printable char...
000AD4  2  8A                   txa
000AD5  2               
000AD5  2               ; All else falls into exit_ok:
000AD5  2               @exit_ok:
000AD5  2  18                   clc                  ; Success exit
000AD6  2  60                   rts
000AD7  2               
000AD7  2               @exit_esc:
000AD7  2  38                   sec                 ; Input abandoned...
000AD8  2  60                   rts
000AD9  2               
000AD9  2               
000AD9  2               
000AD9  2               ;-----------------------------------------------------------
000AD9  2               ; GetLineInput - reads a line of keyboard input
000AD9  2               ;
000AD9  2               ; On Entry: a,x= pointer to the buffer
000AD9  2               ; On Exit:  C=0 ENTER/RETURN was pressed:
000AD9  2               ;             buffer contains null-terminateded input
000AD9  2               ;             y-reg = number of chars entered (0 if RETURN)
000AD9  2               ;             ax-regs destroyed
000AD9  2               ;           C=1 ESC was pressed, no input
000AD9  2               ;             ax-regs destroyed
000AD9  2               ;
000AD9  2               ; Uses: (ZP) scratch0, (ZP) buf_ptr
000AD9  2               ;-----------------------------------------------------------
000AD9  2               
000AD9  2               GetLineInput:
000AD9  2               
000AD9  2  85 38                sta buf_ptr
000ADB  2  86 39                stx buf_ptr+1
000ADD  2               
000ADD  2  64 2E                stz scratch0        ; kbd_buf index
000ADF  2               @read_char:
000ADF  2               
000ADF  2  A9 14                lda #blink_enable   ; Turn ON the blinking cursor:
000AE1  2  A2 00                ldx #0              ; 0=blink enable
000AE3  2  20 AB FE             jsr EXTAPI
000AE6  2               
000AE6  2               @key_wait:
000AE6  2  20 E4 FF             jsr GETIN   ; Trashes y-reg
000AE9  2  C9 00                cmp #0
000AEB  2  F0 F9                beq @key_wait
000AED  2               
000AED  2  48                   pha                   ; A key was pressed, so turn OFF the blinking cursor:
000AEE  2  A9 14                lda #blink_enable
000AF0  2  A2 FF                ldx #$FF             ; $FF=blink disable
000AF2  2  20 AB FE             jsr EXTAPI
000AF5  2  68                   pla
000AF6  2               
000AF6  2  C9 0D                cmp #CR              ; ENTER key?
000AF8  2  F0 46                beq @exit_ok         ; Taken if so
000AFA  2  C9 1B                cmp #ESC             ; ESC key?
000AFC  2  F0 4A                beq @exit_esc        ; Taken if so
000AFE  2  C9 14                cmp #BS              ; Backspace?
000B00  2  F0 25                beq @do_backspace    ; Taken if so
000B02  2               
000B02  2               ; No other control characters, so screen them out:
000B02  2  C9 20                cmp #' '             ; Space is lowest printable char
000B04  2  90 D9                bcc @read_char       ; Ignore char if it is lower than space
000B06  2               
000B06  2               ; We *could* check for high range chars here, but we don't...
000B06  2  A4 2E                ldy scratch0         ; Fetch kbd_buf index
000B08  2  91 38                sta (buf_ptr),y      ; Save character
000B0A  2  20 D2 FF             jsr CHROUT           ; Echo character (xy-regs are preserved)
000B0D  2  C8                   iny                  ; Increment index
000B0E  2  84 2E                sty scratch0
000B10  2  C0 50                cpy #KBD_BUF_SIZE    ; Are we at the max?
000B12  2  D0 CB                bne @read_char       ; Taken if not
000B14  2  C6 2E                dec  scratch0        ; Ignore overflow characters
000B16  2               
000B16  2  A9 14                lda #BS
000B18  2  20 D2 FF             jsr CHROUT           ; And back up the cursor
000B1B  2  A9 20                lda #SPACE
000B1D  2  20 D2 FF             jsr CHROUT           ; And erase it
000B20  2  A9 14                lda #BS
000B22  2  20 D2 FF             jsr CHROUT           ; And back up
000B25  2  80 B8                bra @read_char
000B27  2               
000B27  2               @do_backspace:
000B27  2  A4 2E                ldy scratch0         ; Fetch kbd_buf index
000B29  2  C0 00                cpy #0               ; At start of kbuf?
000B2B  2  F0 B2                beq @read_char       ; Nothing to delete
000B2D  2               
000B2D  2  C6 2E                dec scratch0         ; Move back one char
000B2F  2  A9 14                lda #BS
000B31  2  20 D2 FF             jsr CHROUT           ; Back up the cursor
000B34  2  A9 20                lda #SPACE
000B36  2  20 D2 FF             jsr CHROUT            ; Overwrite char
000B39  2  A9 14                lda #BS               ; Backspace again
000B3B  2  20 D2 FF             jsr CHROUT            ; Move cursor left
000B3E  2  80 9F                bra @read_char
000B40  2               
000B40  2               @exit_ok:
000B40  2  A4 2E                ldy scratch0         ; Fetch kbd_buf index
000B42  2  A9 00                lda #0               ; Null terminate
000B44  2  91 38                sta (buf_ptr),y
000B46  2  18                   clc                  ; Success exit
000B47  2  60                   rts
000B48  2               
000B48  2               @exit_esc:
000B48  2  A9 00                lda #0
000B4A  2  92 38                sta (buf_ptr)
000B4C  2  38                   sec                 ; Input abandoned...
000B4D  2  60                   rts
000B4E  2               
000B4E  2               ;----------------------------------------------------------------
000B4E  2               ; TextToHex - Convert PETSCII hex digit in A-reg to a hex digit
000B4E  2               ;
000B4E  2               ; On Entry: A = PETSCII hex digit (0-9,a-f,A-F)
000B4E  2               ; On Exit:  A = hex digit 0-f
000B4E  2               ;
000B4E  2               ; Note: non-hex digits are undefinied
000B4E  2               ;----------------------------------------------------------------
000B4E  2               TextToHex:
000B4E  2  C9 41                cmp #'a'
000B50  2  B0 04                bcs @alpha
000B52  2  38                   sec
000B53  2  E9 30                sbc #'0'
000B55  2  60                   rts
000B56  2               @alpha:
000B56  2  29 5F                and #$5F                ; Shift UPPER characters to PETSCII
000B58  2  38                   sec
000B59  2  E9 37                sbc #('a'-$a)           ; Map 'a'-'f' to $a-$f
000B5B  2  60                   rts
000B5C  2               
000B5C  2               ;-----------------------------------------------------
000B5C  2               ; StrOut:
000B5C  2               ;   Prior   : Prepare screen and character set
000B5C  2               ;   On Entry: A,X = pointer to zero-terminated string
000B5C  2               ;                   to write to the screen
000B5C  2               ;   On Exit:  C = 0 - success
000B5C  2               ;                 1 - error
000B5C  2               ;             All other regs are preserved
000B5C  2               ;
000B5C  2               ; Uses 2 bytes of ZP: MemPtr and MemPtr+1
000B5C  2               ;-----------------------------------------------------
000B5C  2               StrOut:
000B5C  2  48           		pha
000B5D  2  5A           		phy
000B5E  2  85 24        		sta MemPtr
000B60  2  86 25        		stx MemPtr+1
000B62  2  A0 00        	    ldy #0
000B64  2               @next:
000B64  2  B1 24        		lda (MemPtr),y
000B66  2  F0 08        		beq @done
000B68  2  20 D2 FF     		jsr CHROUT
000B6B  2  B0 03        		bcs @done	; error
000B6D  2  C8           		iny
000B6E  2  D0 F4        		bne @next	; falls through if y wraps around
000B70  2               @done:
000B70  2  7A           		ply
000B71  2  68           		pla
000B72  2  60           		rts
000B73  2               
000B73  2               
000B73  2               ;-------------------------------------------------------------------------
000B73  2               ; StrLen - Returns the length of a zero-terminated string
000B73  2               ;
000B73  2               ;   On Entry: A,X = pointer to zero-terminated string
000B73  2               ;   On Exit:  C = Y = the length of the string
000B73  2               ;             All other regs are preserved
000B73  2               ;
000B73  2               ; Uses 2 bytes of ZP: MemPtr and MemPtr+1
000B73  2               ;
000B73  2               ; Note: The maximum measurable string length is 255 characters
000B73  2               ;       If a string is longer than 256 characters, 255 will be returned
000B73  2               ;-------------------------------------------------------------------------
000B73  2               StrLen:
000B73  2  85 24            sta MemPtr
000B75  2  86 25            stx MemPtr+1
000B77  2               
000B77  2  A0 00            ldy #0
000B79  2               ; Look for the null byte at the end:
000B79  2               @1:
000B79  2  B1 24            lda (MemPtr),y
000B7B  2  F0 04            beq @null_found
000B7D  2  C8               iny
000B7E  2  D0 F9            bne @1
000B80  2               ; String length overflow, return $255
000B80  2  88               dey
000B81  2               
000B81  2               @null_found:
000B81  2  60               rts
000B82  2               
000B82  2               ;-----------------------------------------------------------
000B82  2               ; Hex16Dec - Converts a 16-bit word to ASCII decimal digits
000B82  2               ;
000B82  2               ; On Entry: MemPtr - points to string buffer with room for
000B82  2               ;                    up to 5 digits plus null terminator.
000B82  2               ;           ax - word to be converted
000B82  2               ;
000B82  2               ; On Exit:  (MemPtr) contains 1-5 ASCII digits and a null
000B82  2               ;            terminator
000B82  2               ;
000B82  2               ;           All regs destroyed
000B82  2               ;
000B82  2               ; Uses : (ZP) MemPtr
000B82  2               ;        Hex16Dec_buf (internal buffer - 6 bytes)
000B82  2               ;        quot (2 bytes) - parameter to Div10
000B82  2               ; Calls: Div10
000B82  2               ;-----------------------------------------------------------
000B82  2               Hex16Dec:
000B82  2  8D 1A 0D             sta quot         ; Set up call to Div10
000B85  2  8E 1B 0D             stx quot+1
000B88  2               
000B88  2  A2 00                ldx #0           ; x-reg is our internal buffer index
000B8A  2               
000B8A  2               @next:
000B8A  2  AD 1A 0D             lda quot
000B8D  2  8D 18 0D             sta num
000B90  2  AD 1B 0D             lda quot+1
000B93  2  8D 19 0D             sta num+1
000B96  2  DA                   phx
000B97  2  20 D5 0B             jsr Div10       ; Get first digit
000B9A  2  FA                   plx
000B9B  2  AD 1C 0D             lda rem
000B9E  2  18                   clc             ; Convert to ASCII
000B9F  2  69 30                adc #'0'
000BA1  2  9D CF 0B             sta Hex16Dec_buf,x
000BA4  2  E8                   inx
000BA5  2               
000BA5  2               ; Check the quotient:
000BA5  2  AD 1A 0D             lda quot
000BA8  2  0D 1B 0D             ora quot+1      ; Cheeky way to check 16-bit for zero
000BAB  2  D0 DD                bne @next       ; Taken if quotient is not zero...
000BAD  2               
000BAD  2               ; Prune the leading zeros and reverse the digits into the specified buffer:
000BAD  2               
000BAD  2               ; Find the first non-zero digit. x-reg points past the last digit.
000BAD  2               @next1:
000BAD  2  CA                   dex             ; Point at the last digit
000BAE  2  30 14                bmi @zero       ; Taken if the whole number is zero
000BB0  2  BD CF 0B             lda Hex16Dec_buf,x
000BB3  2  C9 30                cmp #'0'        ; Zero?
000BB5  2  F0 F6                beq @next1      ; Take if so...
000BB7  2               
000BB7  2               ; The string contains at least one non-zero digit and y-reg points at the first one:
000BB7  2               
000BB7  2  A0 00                ldy #0          ; Index to the caller-specified buffer
000BB9  2               @next2:
000BB9  2  BD CF 0B             lda Hex16Dec_buf,x
000BBC  2  91 24                sta (MemPtr),y
000BBE  2  C8                   iny
000BBF  2  CA                   dex
000BC0  2  10 F7                bpl @next2
000BC2  2  80 06                bra @null_term_exit
000BC4  2               
000BC4  2               ; The number is zero so set it up:
000BC4  2               @zero:
000BC4  2  A0 00                ldy #0          ; Has to be set up on this branch.
000BC6  2  A9 30                lda #'0'
000BC8  2  91 24                sta (MemPtr),y  ; Save the '0' character
000BCA  2               @null_term_exit:
000BCA  2               ;        iny
000BCA  2  A9 00                lda #0
000BCC  2  91 24                sta (MemPtr),y  ; null-terminate
000BCE  2  60                   rts
000BCF  2               
000BCF  2  xx xx xx xx  Hex16Dec_buf: .res 6           ; 5 digits and a null (but not needed)
000BD3  2  xx xx        
000BD5  2               
000BD5  2               
000BD5  2               ;-----------------------------------------------------------
000BD5  2               ; Div10 - Divides a 16-bit word by 10 returning the
000BD5  2               ;         quotient and remainder.
000BD5  2               ;
000BD5  2               ; On Entry: num  - set to numerator (16 bits)
000BD5  2               ;
000BD5  2               ; On Exit:  quot - quotient (16 bits)
000BD5  2               ;           rem  - remainder (8 bits)
000BD5  2               ;
000BD5  2               ;           a,x-regs destroyed, y-reg preserved
000BD5  2               ;
000BD5  2               ; Uses: num (2 bytes), quot (2 bytes), rem (1 byte)
000BD5  2               ;
000BD5  2               ; Note:
000BD5  2               ;   * Could speed this up a small amount by using zp for
000BD5  2               ;     variables
000BD5  2               ;-----------------------------------------------------------
000BD5  2               
000BD5  2               Div10:
000BD5  2  9C 1C 0D             stz rem              ; Initialize our outputs
000BD8  2  9C 1A 0D             stz quot
000BDB  2  9C 1B 0D             stz quot+1
000BDE  2               
000BDE  2  A2 10                ldx #16              ; Processing 16 bits
000BE0  2               @next:
000BE0  2  0E 18 0D             asl num              ; Generate 1 bit of the quotient
000BE3  2  2E 19 0D             rol num+1
000BE6  2  2E 1C 0D             rol rem
000BE9  2               
000BE9  2  AD 1C 0D             lda rem
000BEC  2  C9 0A                cmp #10
000BEE  2  90 08                bcc @zero_bit
000BF0  2               
000BF0  2  E9 0A                sbc #10
000BF2  2  8D 1C 0D             sta rem
000BF5  2  38                   sec
000BF6  2  80 01                bra @shift_quot
000BF8  2               
000BF8  2               @zero_bit:
000BF8  2  18                   clc
000BF9  2               
000BF9  2               @shift_quot:
000BF9  2  2E 1A 0D             rol quot
000BFC  2  2E 1B 0D             rol quot+1
000BFF  2  CA                   dex
000C00  2  D0 DE                bne @next
000C02  2  60                   rts
000C03  2               
000C03  2               
000C03  2               ;-----------------------------------------------------------
000C03  2               ; ConvDec16 - Converts a 1-5 digit decimal number to 16-bit
000C03  2               ;            hexidecimal (0-65535)
000C03  2               ;
000C03  2               ; On Entry: ax - pointer to a null-terminated string
000C03  2               ;                containing 1-5 decimal digits (0-65535)
000C03  2               ; On Exit:  C=0 ax contain the 16-bit value
000C03  2               ;           C=1 The string was empty, contained non-numeric
000C03  2               ;               characters, or overflowed 16 bits (see notes).
000C03  2               ;
000C03  2               ; Uses: (ZP) MemPtr, scratch0 , scratch1
000C03  2               ;
000C03  2               ; Notes:
000C03  2               ;   If the calling function ensures that the string has 1-5
000C03  2               ;   decimal digits, then the error return can only be
000C03  2               ;   16-bit overflow (a 5-digit number greater than 65535).
000C03  2               ;-----------------------------------------------------------
000C03  2               ConvDec16:
000C03  2  85 24                sta MemPtr              ; Save the string
000C05  2  86 25                stx MemPtr+1
000C07  2  64 2E                stz scratch0            ; Initialize the value
000C09  2  64 2F                stz scratch0+1
000C0B  2  A0 00                ldy #0                  ; y-reg is the string index
000C0D  2               
000C0D  2               @next_digit:
000C0D  2  B1 24                lda (MemPtr),y          ; Fetch next digit
000C0F  2  F0 44                beq @exit_ok            ; Taken if end of string
000C11  2               
000C11  2  C9 30                cmp #'0'                ; Valid decimal digit?
000C13  2  90 3F                bcc @exit_fail          ; Taken if NOT
000C15  2  C9 3A                cmp #'9'+1
000C17  2  B0 3B                bcs @exit_fail          ;  Taken if not
000C19  2  38                   sec
000C1A  2  E9 30                sbc #'0'                ; Convert to number 0-9
000C1C  2  18                   clc
000C1D  2  65 2E                adc scratch0            ; Add the digit to the value
000C1F  2  85 2E                sta scratch0
000C21  2  A5 2F                lda scratch0+1
000C23  2  69 00                adc #0
000C25  2  85 2F                sta scratch0+1
000C27  2  B0 2B                bcs @exit_fail          ; Taken if 16-bit overflow
000C29  2               
000C29  2  C8                   iny                     ; Index next digit
000C2A  2  B1 24                lda (MemPtr),y          ; End of string?
000C2C  2  F0 27                beq @exit_ok            ; Taken if so
000C2E  2               
000C2E  2               ; To add another decimal digit, first multiply the current value by 10:
000C2E  2  A5 2E                lda scratch0            ; Save original value for later...
000C30  2  85 30                sta scratch1            ; LSB
000C32  2  A5 2F                lda scratch0+1
000C34  2  85 31                sta scratch1+1          ; MSB
000C36  2               
000C36  2  20 5B 0C             jsr @x2                 ; scratch0 x2
000C39  2  B0 19                bcs @exit_fail          ; 16-bit overflow
000C3B  2  20 5B 0C             jsr @x2                 ; scratch0 x4
000C3E  2  B0 14                bcs @exit_fail          ; 16-bit overflow
000C40  2               
000C40  2               ; Add the original value saved earlier to scratch0:
000C40  2  18                   clc
000C41  2  A5 2E                lda scratch0
000C43  2  65 30                adc scratch1
000C45  2  85 2E                sta scratch0            ; lsb x 5
000C47  2               
000C47  2  A5 2F                lda scratch0+1
000C49  2  65 31                adc scratch1+1
000C4B  2  85 2F                sta scratch0+1          ; msb x 5
000C4D  2  B0 05                bcs @exit_fail          ; 16-bit overflow
000C4F  2               
000C4F  2               ; With the value multiplied by 5, do one more x2 get x10:
000C4F  2  20 5B 0C             jsr @x2
000C52  2  90 B9                bcc @next_digit         ; Continue if no olverflow
000C54  2               
000C54  2               @exit_fail:
000C54  2  60                   rts
000C55  2               
000C55  2               @exit_ok:
000C55  2  18                   clc
000C56  2  A5 2E                lda scratch0            ; Return the value
000C58  2  A6 2F                ldx scratch0+1
000C5A  2  60                   rts
000C5B  2               
000C5B  2               
000C5B  2               ; Function to multiply scratch0 (16 bits) by 2:
000C5B  2               ; If c=1 on exit, 16-bit overflow occured.
000C5B  2               @x2:
000C5B  2  18                   clc
000C5C  2  A5 2E                lda scratch0
000C5E  2  0A                   asl a                   ; x 2
000C5F  2  85 2E                sta scratch0
000C61  2  A5 2F                lda scratch0+1
000C63  2  2A                   rol a
000C64  2  85 2F                sta scratch0+1
000C66  2  60                   rts
000C67  2               
000C67  2               
000C67  2               
000C67  2               
000C67  2               ;--------------------------------------------------
000C67  2               ; Word32Out - prints a 4-byte word in hexadecimal
000C67  2               ;
000C67  2               ; inputs : a,x = POINTER to 4-byte word
000C67  2               ; outputs: All regs destroyed
000C67  2               ; calls  : WordOut
000C67  2               ; Uses: (zp) MemPtr (2 bytes)
000C67  2               ;--------------------------------------------------
000C67  2               
000C67  2               Word32Out:
000C67  2  85 24                sta MemPtr
000C69  2  86 25                stx MemPtr+1
000C6B  2               
000C6B  2  A0 03                ldy #3
000C6D  2  B1 24                lda (MemPtr),y       ; MSB
000C6F  2               
000C6F  2  AA                   tax
000C70  2  88                   dey
000C71  2  B1 24                lda (MemPtr),y       ; LSB
000C73  2               
000C73  2  20 82 0C             jsr WordOut
000C76  2               
000C76  2  A0 01                ldy #1
000C78  2  B1 24                lda (MemPtr),y       ; MSB
000C7A  2               
000C7A  2  AA                   tax
000C7B  2  88                   dey
000C7C  2  B1 24                lda (MemPtr),y       ; LSB
000C7E  2               
000C7E  2  20 82 0C             jsr WordOut
000C81  2  60                   rts
000C82  2               
000C82  2               ;----------------------------------------------
000C82  2               ; WordOut - prints a given word in hexadecimal
000C82  2               ;
000C82  2               ; inputs : a,x = word to print l,h
000C82  2               ; outputs: a reg destroyed
000C82  2               ; uses   : none
000C82  2               ; calls  : ByteOut
000C82  2               ; notes  : none
000C82  2               
000C82  2               WordOut:
000C82  2  48           	pha                    	 ; save low byte
000C83  2  8A           	txa
000C84  2  20 92 0C     	jsr     ByteOut          ; show high byte
000C87  2  68           	pla
000C88  2  80 08        	bra     ByteOut          ; show low byte
000C8A  2               
000C8A  2               ;-----------------------------------------------------------
000C8A  2               ; Hex3Out - prints the hex value of 3 digit value
000C8A  2               ;
000C8A  2               ; inputs : a,x = 3 hex digits to print (l,h)
000C8A  2               ; outputs: a-reg = destroyed
000C8A  2               ; uses   : none
000C8A  2               ; calls  : CHROUT
000C8A  2               ; notes  : prints hex A-F in upper case
000C8A  2               Hex3Out:
000C8A  2               
000C8A  2  48            	pha                    	 ; save low byte
000C8B  2  8A           	txa
000C8C  2  20 9B 0C     	jsr     prnibble0        ; low digit of high byte
000C8F  2  68           	pla
000C90  2  80 00        	bra     ByteOut          ; show low byte
000C92  2               
000C92  2               ;-----------------------------------------------------------
000C92  2               ; ByteOut - prints the hex value of a given byte
000C92  2               ;
000C92  2               ; inputs : a-reg = byte to print
000C92  2               ; outputs: a-reg = destroyed
000C92  2               ; uses   : none
000C92  2               ; calls  : CHROUT
000C92  2               ; notes  : prints hex A-F in upper case
000C92  2               
000C92  2               ByteOut:
000C92  2  48           		pha                     ; save value
000C93  2  4A           		lsr                     ; spin hi nibble->low
000C94  2  4A           		lsr
000C95  2  4A           		lsr
000C96  2  4A           		lsr
000C97  2  20 9D 0C     		jsr     prnibble        ; show high nibble
000C9A  2  68           		pla                     ; then low nibble...
000C9B  2               prnibble0:
000C9B  2  29 0F        		and     #$0f            ; form table index
000C9D  2               prnibble:
000C9D  2  DA                           phx
000C9E  2  AA                           tax                     ; use digit number as index
000C9F  2  BD A6 0C                     lda hextab,x
000CA2  2  FA                           plx
000CA3  2               
000CA3  2               		;clc
000CA3  2               		;adc     #'0'
000CA3  2               		;cmp     #'9'+1           ; need adjustment?
000CA3  2               		;bcc     @noadj          ; taken if not (0-9)
000CA3  2               		;adc     #6              ; 6 + set carry = 7
000CA3  2               @noadj:
000CA3  2  4C D2 FF     		jmp     CHROUT     	    ; preserves all regs
000CA6  2               
000CA6  2  30 31 32 33  hextab:	.byte	"0123456789ABCDEF"
000CAA  2  34 35 36 37  
000CAE  2  38 39 C1 C2  
000CB6  2               
000CB6  2               ;-----------------------------------------------------
000CB6  2               ; FileExists
000CB6  2               ;
000CB6  2               ; Written by Tony3068 and posted on Discord:
000CB6  2               ; https://discord.com/channels/547559626024157184/629863245934755860/1359286644150108374
000CB6  2               ;
000CB6  2               ;   On Entry:   A   = length of name
000CB6  2               ;               X,Y = pointer to filename string
000CB6  2               ;   On Exit:  C = 0 - File exists
000CB6  2               ;                 1 - File does NOT exist
000CB6  2               ;             All other regs are preserved
000CB6  2               ;
000CB6  2               ; Note: The call setup is the same as SETNAM
000CB6  2               ;-----------------------------------------------------
000CB6  2               FileExists:
000CB6  2               
000CB6  2  48                   pha
000CB7  2  DA                   phx
000CB8  2  5A                   phy
000CB9  2               
000CB9  2               ; Open and then immediately close the file:
000CB9  2  20 BD FF             jsr SETNAM
000CBC  2  A9 05                lda #FILE_EXISTS_LFN        ; LFN
000CBE  2  A2 08                ldx #8                      ; Device
000CC0  2  A8                   tay                         ; Use LFN as secondary
000CC1  2  20 BA FF             jsr SETLFS
000CC4  2  20 C0 FF             jsr OPEN
000CC7  2  A9 05                lda #FILE_EXISTS_LFN       ; LFN
000CC9  2  20 C3 FF             jsr CLOSE
000CCC  2               
000CCC  2               ; Open the error channel and check the result:
000CCC  2  A9 00                lda #0
000CCE  2  A2 17                ldx #<Dummy_name
000CD0  2  A0 0D                ldy #>Dummy_name
000CD2  2  20 BD FF             jsr SETNAM
000CD5  2  A9 0F                lda #15
000CD7  2  A2 08                ldx #8
000CD9  2  A0 0F                ldy #15
000CDB  2  20 BA FF             jsr SETLFS       ; All regs preserved
000CDE  2  20 C0 FF             jsr OPEN
000CE1  2               
000CE1  2  A2 0F                ldx #15
000CE3  2  20 C6 FF             jsr CHKIN        ; Destroys all regs, but it is OK
000CE6  2  20 E4 FF             jsr GETIN
000CE9  2  C9 30                cmp #'0'
000CEB  2  D0 07                bne _NotFound
000CED  2  20 E4 FF             jsr GETIN
000CF0  2  C9 30                cmp #'0'
000CF2  2  F0 0B                beq _Found
000CF4  2               
000CF4  2               _NotFound:
000CF4  2  20 0A 0D             jsr _flushchars
000CF7  2  20 CC FF             jsr CLRCHN
000CFA  2  7A                   ply
000CFB  2  FA                   plx
000CFC  2  68                   pla
000CFD  2  38                   sec
000CFE  2  60                   rts
000CFF  2               
000CFF  2               _Found:
000CFF  2  20 0A 0D             jsr _flushchars
000D02  2  20 CC FF             jsr CLRCHN
000D05  2  7A                   ply
000D06  2  FA                   plx
000D07  2  68                   pla
000D08  2  18                   clc
000D09  2  60                   rts
000D0A  2               
000D0A  2               ; Clear the rest of the error message:
000D0A  2               _flushchars:
000D0A  2  20 E4 FF             jsr GETIN
000D0D  2  C9 0D                cmp #13
000D0F  2  D0 F9                bne _flushchars
000D11  2  A9 0F                lda #15
000D13  2  20 C3 FF             jsr CLOSE
000D16  2  60                   rts
